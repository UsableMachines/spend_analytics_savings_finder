# Spend Analytics Savings Finder — Environment Variables
SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///app.db

# Kindo AI Agent (required for AI analysis features)
KINDO_API_TOKEN=
KINDO_AGENT_ID=

# Server
PORT=8080
WEB_CONCURRENCY=2
APP_GUNICORN_TIMEOUT=120
APP_AGENT_POLL_TIMEOUT_SEC=120

# Session
SESSION_COOKIE_PATH=/
SESSION_COOKIE_SECURE=false
